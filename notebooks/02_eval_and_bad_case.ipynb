  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Test Set 终值评测"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Cell 1: test set evaluation\n",
    "import sys; sys.path.insert(0, '../src')\n",
    "from pathlib import Path\n",
    "from utils.eval_protocol import EVAL_CONFIG\n",
    "from ultralytics import YOLO\n",
    "\n",
    "model = YOLO('../models/exp4_crazing_focus/weights/best.pt')\n",
    "r = model.val(data='../configs/data.yaml', split='test', workers=0,\n",
    "              project='../results', name='test_final', exist_ok=True, **EVAL_CONFIG)\n",
    "\n",
    "print(f\"{'Class':<20} {'mAP@0.5':>8} {'mAP@0.5:.95':>12} {'Precision':>10} {'Recall':>8}\")\n",
    "print('-' * 60)\n",
    "for i, cls_id in enumerate(r.ap_class_index):\n",
    "    print(f'{r.names[cls_id]:<20} {float(r.box.ap50[i]):>8.4f} {float(r.box.ap[i]):>12.4f} {float(r.box.p[i]):>10.4f} {float(r.box.r[i]):>8.4f}')\n",
    "print('-' * 60)\n",
    "print(f\"{'Overall':<20} {float(r.box.map50):>8.4f} {float(r.box.map):>12.4f}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. 分尺度 bbox 分布"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Cell 2: per-scale bbox distribution on test set\n",
    "from collections import defaultdict\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "DATA = Path('../data/raw/NEU-DET')\n",
    "SPLITS = Path('../data/splits')\n",
    "CLASSES = ['crazing','inclusion','patches','pitted_surface','rolled-in_scale','scratches']\n",
    "SMALL, LARGE = 32**2, 96**2\n",
    "\n",
    "test_stems = set((SPLITS/'test.txt').read_text().splitlines())\n",
    "stats = {c: {'small':0,'medium':0,'large':0} for c in CLASSES}\n",
    "\n",
    "for split in ['train','validation']:\n",
    "    for xml_path in (DATA/split/'annotations').glob('*.xml'):\n",
    "        if xml_path.stem not in test_stems: continue\n",
    "        tree = ET.parse(xml_path); root = tree.getroot()\n",
    "        for obj in root.findall('object'):\n",
    "            name = obj.find('name').text.strip()\n",
    "            if name not in CLASSES: continue\n",
    "            bb = obj.find('bndbox')\n",
    "            w=float(bb.find('xmax').text)-float(bb.find('xmin').text)\n",
    "            h=float(bb.find('ymax').text)-float(bb.find('ymin').text)\n",
    "            a=w*h\n",
    "            stats[name]['small' if a<SMALL else ('large' if a>=LARGE else 'medium')] += 1\n",
    "\n",
    "print(f\"{'Class':<20} {'small':>6} {'medium':>6} {'large':>6}\")\n",
    "for c in CLASSES:\n",
    "    print(f\"{c:<20} {stats[c]['small']:>6} {stats[c]['medium']:>6} {stats[c]['large']:>6}\")\n",
    "print()\n",
    "for c in CLASSES:\n",
    "    for s in ['small','medium','large']:\n",
    "        if stats[c][s] < 30:\n",
    "            print(f'WARNING: {c} {s} = {stats[c][s]} (<30) - do not report on resume')"
   ],
   "outputs": [],
   "execution_count": null
  },
